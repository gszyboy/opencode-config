{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      503,
      500,
      502,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "tmux_visualization": false
  },
  "tmux": {
    "enabled": false
  },
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "agents": {
    "hephaestus": {
      "model": "gpt-agent/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "deepseek/deepseek-v4-pro",
        "opencode-go/glm-5.1"
      ]
    },
    "oracle": {
      "model": "kimi-for-coding/k2p6",
      "variant": "high",
      "fallback_models": [
        "opencode-go/glm-5.1"
      ]
    },
    "librarian": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "explore": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "multimodal-looker": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5",
      "fallback_models": [
        "gpt-agent/gemini-3.1-pro",
        "gpt-agent/mimo-v2-omni"
      ]
    },
    "prometheus": {
      "model": "kimi-for-coding/k2p6",
      "variant": "high",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro"
      ],
      "prompt_append": "Leverage deep & quick agents heavily, always in parallel."
    },
    "metis": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "momus": {
      "model": "gpt-agent/gpt-5.5",
      "fallback_models": [
        "deepseek/deepseek-v4-pro",
        "opencode-go/glm-5.1"
      ]
    },
    "atlas": {
      "model": "minimax-cn-coding-plan/MiniMax-M3",
      "variant": "high",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5.1"
      ]
    },
    "sisyphus-junior": {
      "model": "minimax-cn-coding-plan/MiniMax-M3",
      "variant": "high",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/glm-5.1"
      ]
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "variant": "high",
      "ultrawork": {
        "model": "kimi-for-coding/k2p6",
        "variant": "high",
        "fallback_models": [
          "xiaomi-token-plan-cn/mimo-v2.5-pro",
          "minimax-cn-coding-plan/MiniMax-M2.7"
        ]
      },
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "deepseek/deepseek-v4-pro",
        "opencode-go/mimo-v2.5-pro"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "minimax-cn-coding-plan/MiniMax-M3",
      "variant": "high",
      "fallback_models": [
        "xiaomi-token-plan-cn/mimo-v2.5-pro"
      ]
    },
    "ultrabrain": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
      "reasoningEffort": "xhigh",
      "fallback_models": [
        "deepseek/deepseek-v4-pro",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "deep": {
      "model": "minimax-cn-coding-plan/MiniMax-M3",
      "fallback_models": [
        "deepseek/deepseek-v4-pro",
        "opencode-go/glm-5.1"
      ]
    },
    "artistry": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
      "fallback_models": [
        "deepseek/deepseek-v4-pro",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "quick": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "unspecified-low": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "unspecified-high": {
      "model": "minimax-cn-coding-plan/MiniMax-M3",
      "variant": "high",
      "fallback_models": [
        "xiaomi-token-plan-cn/mimo-v2.5-pro",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "writing": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "variant": "high",
      "fallback_models": [
        "deepseek/deepseek-v4-flash",
        "opencode-go/glm-5.1"
      ]
    }
  }
}