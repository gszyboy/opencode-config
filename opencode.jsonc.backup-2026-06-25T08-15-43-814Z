{
    "$schema": "https://opencode.ai/config.json",
    "model": "minimax-cn-coding-plan/MiniMax-M3",
    "small_model": "minimax-cn-coding-plan/MiniMax-M2.7",
    "provider": {
        "sense-nova": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Sense Nova",
            "options": {
                "baseURL": "https://token.sensenova.cn/v1",
                "apiKey": "{env:SENSENOVA_API_KEY}"
            },
            "models": {
                "sensenova-6.7-flash-lite": {
                    "name": "SenseNova 6.7 Flash-Lite",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 256000,
                        "output": 65536
                    }
                }
            }
        },
        "kimi-custom": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "kimi-custom",
            "options": {
                "baseURL": "https://api.kimi.com/coding/v1",
                "apiKey": "{env:KIMI_API_KEY_2}",
                "compatibility": "compatible"
            },
            "models": {
                "kimi-for-coding": {
                    "name": "kimi-for-coding",
                    "limit": {
                        "context": 262144,
                        "output": 65536
                    }
                }
            }
        },
        "agnes-ai": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Agnes AI",
            "options": {
                "baseURL": "https://apihub.agnes-ai.com/v1",
                "apiKey": "{env:AGNESAI_API_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "agnes-2.0-flash": {
                    "name": "agnes-2.0-flash",
                    "limit": {
                        "context": 256000,
                        "output": 65536
                    }
                }
            }
        },
        "xydev": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "xydev.xyz",
            "options": {
                "baseURL": "https://ai.xydev.xyz/v1",
                "apiKey": "{env:XYDEV_API_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "MiniMax-M2.7": {
                    "name": "MiniMax-M2.7",
                    "limit": {
                        "context": 204800,
                        "output": 65536
                    }
                },
                "gpt-image-2": {
                    "name": "GPT Image 2",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "image"
                        ]
                    }
                }
            }
        },
        "gpt-agent": {
            "npm": "@ai-sdk/anthropic",
            "name": "GPT Agent Relay",
            "options": {
                "baseURL": "{env:GPT_AGENT_URL}",
                "apiKey": "{env:GPT_AGENT_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "gemini-3.1-pro": {
                    "name": "Gemini 3.1 Pro",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 65536
                    }
                },
                "gpt-5.4": {
                    "name": "GPT 5.4",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "gpt-5.5": {
                    "name": "GPT 5.5",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "claude-opus-4-7": {
                    "name": "Claude Opus 4-7",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    }
                },
                "glm-5.1": {
                    "name": "GLM-5.1",
                    "modalities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 204800,
                        "output": 65536
                    }
                },"claude-sonnet-4-6": {
                    "name": "claude-sonnet-4-6",
                    "modalities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    }
                },
                "gemini-3.5-flash": {
                    "name": "Gemini 3.5 Flash",
                    "modalities": {
                        "input": [
                            "text",
                            "image",
                            "video",
                            "audio",
                            "pdf"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 65536
                    }
                },
                "gpt-image-2": {
                    "name": "GPT Image 2",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "image"
                        ]
                    }
                }
            }
        }
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@executeautomation/playwright-mcp-server"
            ],
            "enabled": false
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "{env:CONTEXT7_API_KEY}"
            ],
            "enabled": true
        },
        "filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "~"
            ]
        },
        "MiniMax": {
            "type": "local",
            "command": [
                "uvx",
                "minimax-coding-plan-mcp",
                "-y"
            ],
            "environment": {
                "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
                "MINIMAX_API_HOST": "https://api.minimaxi.com"
            },
            "enabled": true
        },
        "codegraph": {
          "type": "local",
          "command": [
            "codegraph",
            "serve",
            "--mcp"
          ],
          "enabled": true
        }
    },
    "tools": {
        "MiniMax": true
    },
    "instructions": [
        "~/.config/opencode/docs/general-rules.md",
        "~/.config/opencode/docs/backend-rules.md",
        "~/.config/opencode/docs/frontend-rules.md",
        "~/.config/opencode/docs/typescript-rules.md",
        "~/.config/opencode/docs/existing-project-rules.md"
    ],
    "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "oh-my-openagent@latest",
    "@honcho-ai/opencode-honcho"
  ]
}