{
    "$schema": "https://opencode.ai/config.json",
    "model": "kimi-for-coding/k2p6",
    "small_model": "minimax-cn-coding-plan/MiniMax-M3",
    "provider": {
        "kimi-custom": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "kimi-custom",
            "options": {
                "baseURL": "https://api.kimi.com/coding/v1",
                "apiKey": "{env:KIMI_API_KEY_2}",
                "compatibility": "compatible"
            },
            "models": {
                "kimi-for-coding": {
                    "name": "kimi-for-coding",
                    "limit": {
                        "context": 262144,
                        "output": 65536
                    }
                }
            }
        },
        "minimax-custom": {
            "npm": "@ai-sdk/anthropic",
            "name": "minimax-custom",
            "options": {
                "baseURL": "https://api.minimaxi.com/anthropic/v1",
                "apiKey": "{env:MINIMAX_API_KEY_2}",
                "compatibility": "compatible"
            },
            "models": {
                "MiniMax-M3": {
                    "name": "MiniMax-M3",
                    "limit": {
                        "context": 1000000,
                        "output": 65536
                    }
                }
            }
        },
        "xydev": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "xydev.xyz",
            "options": {
                "baseURL": "https://ai.xydev.xyz/v1",
                "apiKey": "{env:XYDEV_API_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "MiniMax-M2.7": {
                    "name": "MiniMax-M2.7",
                    "limit": {
                        "context": 204800,
                        "output": 65536
                    }
                },
                "gpt-image-2": {
                    "name": "GPT Image 2",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "image"
                        ]
                    }
                }
            }
        },
        "claudeapi": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "claudeapi.win",
            "options": {
                "baseURL": "{env:CLAUDEAPI_API_URL}",
                "apiKey": "{env:CLAUDEAPI_API_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "gpt-5.5": {
                    "name": "gpt-5.5",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "gpt-image-2": {
                    "name": "GPT Image 2",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "image"
                        ]
                    }
                }
            }
        },
        "gpt-agent": {
            "npm": "@ai-sdk/anthropic",
            "name": "GPT Agent Relay",
            "options": {
                "baseURL": "{env:GPT_AGENT_URL}",
                "apiKey": "{env:GPT_AGENT_KEY}",
                "compatibility": "compatible"
            },
            "models": {
                "gemini-3.1-pro": {
                    "name": "Gemini 3.1 Pro",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 65536
                    }
                },
                "gpt-5.4": {
                    "name": "GPT 5.4",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "gpt-5.5": {
                    "name": "GPT 5.5",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "claude-opus-4-7": {
                    "name": "Claude Opus 4-7",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    }
                },
                "glm-5.1": {
                    "name": "GLM-5.1",
                    "modalities": {
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 204800,
                        "output": 65536
                    }
                },
                "gemini-3.5-flash": {
                    "name": "Gemini 3.5 Flash",
                    "modalities": {
                        "input": [
                            "text",
                            "image",
                            "video",
                            "audio",
                            "pdf"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 65536
                    }
                },
                "gpt-image-2": {
                    "name": "GPT Image 2",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "image"
                        ]
                    }
                }
            }
        }
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@executeautomation/playwright-mcp-server"
            ],
            "enabled": false
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "{env:CONTEXT7_API_KEY}"
            ],
            "enabled": true
        },
        "filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "~"
            ]
        },
        "MiniMax": {
            "type": "local",
            "command": [
                "uvx",
                "minimax-coding-plan-mcp",
                "-y"
            ],
            "environment": {
                "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
                "MINIMAX_API_HOST": "https://api.minimaxi.com"
            },
            "enabled": true
        }
    },
    "tools": {
        "MiniMax": true
    },
    "instructions": [
        "~/.config/opencode/docs/general-rules.md",
        "~/.config/opencode/docs/backend-rules.md",
        "~/.config/opencode/docs/frontend-rules.md",
        "~/.config/opencode/docs/typescript-rules.md",
        "~/.config/opencode/docs/existing-project-rules.md"
    ],
    "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "oh-my-openagent"
  ]
}