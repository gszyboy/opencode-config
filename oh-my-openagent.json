{
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
    "runtime_fallback": {
        "enabled": true,
        "retry_on_errors": [400, 401, 402, 403, 404, 429, 500, 502, 503, 504],
        "max_fallback_attempts": 3,
        "cooldown_seconds": 15,
        "timeout_seconds": 10
    },
    "agents": {
        "sisyphus": {
            "model": "minimax-cn-coding-plan/MiniMax-M3",
            "fallback_models": [
                {
                    "model": "kimi-for-coding/k2p6"
                },
                {
                    "model": "kimi-for-coding/k2p6"
                },
                {
                    "model": "gpt-agent/gpt-5.5",
                    "variant": "medium"
                }
            ]
        },
        "hephaestus": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "medium",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                }
            ]
        },
        "oracle": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "high",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                },{
                    "model": "opencode-go/glm-5.2"
                }
            ]
        },
        "librarian": {
            "model": "minimax-cn-coding-plan/MiniMax-2.7",
            "fallback_models": [
                {
                    "model": "opencode-go/qwen3.5-plus"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        },
        "explore": {
            "model": "minimax-cn-coding-plan/MiniMax-2.7",
            "fallback_models": [
                {
                    "model": "opencode-go/qwen3.5-plus"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        },
        "multimodal-looker": {
            "model": "opencode-go/mimo-v2.5",
            "fallback_models": [
                {
                    "model": "Step-Plan/step-3.7-flash"
                }
            ]
        },
        "prometheus": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "high",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                }
            ]
        },
        "metis": {
            "model": "apikey-fun/gpt-5.4",
            "variant": "xhigh",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.4"
                },
                {
                    "model": "kimi-for-coding/k2p6"
                }
            ]
        },
        "momus": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "xhigh",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                }
            ]
        },
        "atlas": {
            "model": "opencode-go/kimi-k2.7",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.4",
                    "variant": "medium"
                },
                {
                    "model": "opencode-go/minimax-m3"
                },
                {
                    "model": "minimax-cn-coding-plan/MiniMax-M3"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        },
        "sisyphus-junior": {
            "model": "kimi-for-coding/k2p6",
            "fallback_models": [
                {
                    "model": "minimax-cn-coding-plan/MiniMax-M3"
                },
                {
                    "model": "opencode-go/minimax-m3"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        }
    },
    "categories": {
        "visual-engineering": {
            "model": "apikey-fun/gpt-5.4",
            "fallback_models": [
               
                {
                    "model": "kimi-for-coding/k2p5"
                },
                {
                    "model": "opencode-go/glm-5.2"
                }
            ]
        },
        "ultrabrain": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "xhigh",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                }
            ]
        },
        "deep": {
            "model": "apikey-fun/gpt-5.5",
            "variant": "medium",
            "fallback_models": [
                {
                    "model": "gpt-agent/gpt-5.5"
                },
                {
                    "model": "opencode-go/glm-5.2"
                }
            ]
        },
        "artistry": {
            "model": "kimi-for-coding/k2p6",
            "fallback_models": [
                {
                    "model": "opencode-go/glm-5.2"
                },
                {
                    "model": "opencode-go/kimi-k2.7"
                }
            ]
        },
        "quick": {
            "model": "minimax-cn-coding-plan/MiniMax-M2.7",
            "fallback_models": [
                {
                    "model": "opencode-go/minimax-m2.7"
                },
                {
                    "model": "apikey-fun/gpt-5.4-mini"
                }
            ]
        },
        "unspecified-low": {
            "model": "opencode-go/qwen3.7-plus",
            "fallback_models": [
                {
                    "model": "kimi-for-coding/k2p5"
                },
                {
                    "model": "minimax-cn-coding-plan/MiniMax-M2.7"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        },
        "unspecified-high": {
            "model": "apikey-fun/gpt-5.4",
            "fallback_models": [
                {
                    "model": "kimi-for-coding/k2p6"
                },
                {
                    "model": "minimax-cn-coding-plan/MiniMax-M3"
                },
                {
                    "model": "opencode-go/minimax-m3"
                }
            ]
        },
        "writing": {
            "model": "opencode-go/kimi-k2.7",
            "fallback_models": [
                {
                    "model": "kimi-for-coding/k2p6"
                },
                {
                    "model": "minimax-cn-coding-plan/MiniMax-M3"
                },
                {
                    "model": "opencode-go/minimax-m2.7"
                }
            ]
        }
    },
    "team_mode": {
        "enabled": false,
        "max_parallel_members": 4,
        "max_members": 8,
        "tmux_visualization": false
    },
    "sisyphus_agent": {
        "default_builder_enabled": true
    }
}