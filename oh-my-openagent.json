{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 503, 500, 502, 504],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "agents": {
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "variant": "medium",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "gpt-agent/gpt-5.5"
      ]
    },
    "oracle": {
      "model": "kimi-for-coding/k2p6",
      "variant": "high",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro",
        "opencode-go/glm-5.1"
      ]
    },
    "librarian": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "kimi-for-coding/k2p6"
      ]
    },
    "explore": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "kimi-for-coding/k2p6"
      ]
    },
    "multimodal-looker": {
      "model": "opencode-go/mimo-v2.5",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "kimi-for-coding/k2p6"
      ]
    },
    "prometheus": {
      "model": "opencode-go/mimo-v2.5-pro",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "kimi-for-coding/k2p6"
      ],
      "prompt_append": "Leverage deep & quick agents heavily, always in parallel."
    },
    "metis": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5.1"
      ]
    },
    "momus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "atlas": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5.1"
      ]
    },
    "sisyphus-junior": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5.1"
      ]
    },
    "sisyphus": {
      "model": "opencode-go/mimo-v2.5-pro",
      "ultrawork": {
        "model": "opencode-go/mimo-v2.5-pro",
        "variant": "high",
        "fallback_models": [
          "kimi-for-coding/k2p6",
          "minimax-cn-coding-plan/MiniMax-M2.7"
        ]
      },
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/mimo-v2.5-pro",
      "variant": "high",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "ultrabrain": {
      "model": "opencode-go/mimo-v2.5-pro",
      "reasoningEffort": "xhigh",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "deep": {
      "model": "opencode-go/mimo-v2.5-pro",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "artistry": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "quick": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "kimi-for-coding/k2p6"
      ]
    },
    "unspecified-low": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "kimi-for-coding/k2p6"
      ]
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "opencode-go/mimo-v2.5-pro",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "writing": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5.1"
      ]
    }
  }
}
